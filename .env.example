# Copy to surge-ai/.env and fill in. Never commit the real .env.
#
# Single-host deployment: everything runs on the Mac mini, so every service
# address here is localhost. The one exception is the dashboard's public URL,
# which must be the tailnet address because the browser is on someone else's
# machine.

# --- Database (local Postgres via Homebrew) ---
DATABASE_URL=postgresql+asyncpg://surge:pick-something@localhost:5432/surge

# --- LLM: analysis + fast tiers go to OpenRouter ---
# Models are set in surge-ai/config/constants.py (analysis: z-ai/glm-4.7,
# fast: z-ai/glm-4.7-flash) and overridable at runtime from the Settings page.
OPENROUTER_API_KEY=sk-or-...

# --- LLM: local fallback, used only when credits run out ---
# Historical name; it's just the Ollama OpenAI-compatible endpoint, now local.
TAILSCALE_URL=http://localhost:11434/v1

# --- CORS ---
# Blank allows all origins, which is fine for a tailnet-only deployment.
# To lock down: CORS_ORIGINS=http://macmini.your-tailnet.ts.net:3000
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# The dashboard does NOT read this file. Its two variables are compiled into
# the bundle at build time and belong in web-page/.env.local:
#
#   NEXT_PUBLIC_API_URL=http://macmini.your-tailnet.ts.net:8000
#   NEXT_PUBLIC_WS_URL=ws://macmini.your-tailnet.ts.net:8000
#
# Use the Mac mini's tailnet address, never localhost — that would resolve to
# the viewer's own laptop. Changing it requires `npm run build` again.
# ---------------------------------------------------------------------------
