# Copy to .env and fill in. Never commit the real .env.
#
# This file covers BOTH halves of the split deployment. Each host only needs
# its own section — but it's kept as one file so the two stay in sync.
#
#   HCU server  → Postgres + Ollama          (state and the LLM)
#   Mac mini    → FastAPI + nmap + Next.js   (the scanner and the site)

# ===========================================================================
# HCU SERVER  (used by docker-compose.hcu.yml)
# ===========================================================================

# Password for the Postgres container. The Mac mini needs this same value in
# its DATABASE_URL below, so pick it once and copy it across.
POSTGRES_PASSWORD=change-me-to-something-strong

# The HCU server's own Tailscale IP (`tailscale ip -4`). Postgres binds to
# THIS address only — not 0.0.0.0, which would expose the DB to campus.
HCU_TAILSCALE_IP=100.x.y.z

# ===========================================================================
# MAC MINI  (used by the native backend + frontend — see DEPLOY.md Part B)
# ===========================================================================

# --- Database: now REMOTE, pointing at the HCU server ---
# Host is the HCU server's Tailscale name or IP. This is the single biggest
# change from the old single-host layout, where it was localhost.
DATABASE_URL=postgresql+asyncpg://surge:change-me-to-something-strong@hcu-server.your-tailnet.ts.net:5432/surge

# --- LLM ---
# Local/offline tier. Despite the name this is just the Ollama OpenAI-compatible
# endpoint; it now points at the HCU server across the tailnet, not localhost.
# Ollama must be started with OLLAMA_HOST set or it will refuse this connection
# (see DEPLOY.md Part A step 3).
TAILSCALE_URL=http://hcu-server.your-tailnet.ts.net:11434/v1

# Analysis tier (heavy reasoning / report synthesis) — goes out to OpenRouter.
OPENROUTER_API_KEY=sk-or-...

# --- Frontend (BUILD-TIME — see the gotcha in DEPLOY.md) ---
# The address the BROWSER uses to reach the backend. The backend runs on the
# MAC MINI, so this is the Mac mini's Tailscale address — not the HCU server's,
# and not localhost (that would resolve to the viewer's own laptop).
NEXT_PUBLIC_API_URL=http://macmini.your-tailnet.ts.net:8000
NEXT_PUBLIC_WS_URL=ws://macmini.your-tailnet.ts.net:8000

# --- CORS (optional) ---
# Blank = allow all origins, which is fine for a tailnet-only deployment.
# To lock down, set the frontend's origin:
#   CORS_ORIGINS=http://macmini.your-tailnet.ts.net:3000
CORS_ORIGINS=
